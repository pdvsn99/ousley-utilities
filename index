<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Ousley Utilities</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;1,9..144,300;1,9..144,400&family=Figtree:wght@300;400;500&display=swap" rel="stylesheet" />
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --plum:    #1B0D36;
  --violet:  #5A3A8C;
  --violet2: #7B55B2;
  --lavender:#C8B4E2;
  --pale:    #F0EAF9;
  --off:     #FAFAF7;
  --sand:    #D4A96A;
  --muted:   #9688A8;
  --ink:     #1B0D36;
  --ff-d:    'Fraunces', Georgia, serif;
  --ff-b:    'Figtree', sans-serif;
}
html { scroll-behavior: smooth; }
body { background: var(--off); color: var(--ink); font-family: var(--ff-b); font-weight: 300; overflow-x: hidden; }

/* NAV */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  display: flex; align-items: center; justify-content: space-between;
  padding: 1.6rem 4rem;
  transition: background 0.5s, backdrop-filter 0.5s, border-color 0.5s;
}
nav.scrolled { background: rgba(250,250,247,0.92); backdrop-filter: blur(14px); border-bottom: 1px solid rgba(90,58,140,0.12); }
.nav-logo { font-family: var(--ff-d); font-size: 1.2rem; font-weight: 400; letter-spacing: 0.03em; color: #fff; text-decoration: none; transition: color 0.5s; }
nav.scrolled .nav-logo { color: var(--plum); }
.nav-links { display: flex; gap: 2.8rem; list-style: none; }
.nav-links a { font-size: 0.76rem; font-weight: 400; letter-spacing: 0.13em; text-transform: uppercase; color: rgba(255,255,255,0.5); text-decoration: none; transition: color 0.3s; }
nav.scrolled .nav-links a { color: var(--muted); }
.nav-links a:hover, nav.scrolled .nav-links a:hover { color: var(--violet); }
.nav-cta { font-size: 0.73rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--plum); background: var(--lavender); padding: 0.55rem 1.3rem; text-decoration: none; border-radius: 2px; transition: background 0.3s; }
.nav-cta:hover { background: var(--sand); }

/* HERO */
#hero { position: relative; min-height: 100vh; background: var(--plum); display: flex; flex-direction: column; justify-content: flex-end; padding: 0 4rem 5.5rem; overflow: hidden; }
.hero-arc { position: absolute; top: -12vw; right: -14vw; width: 70vw; height: 70vw; border-radius: 50%; border: 1px solid rgba(200,180,226,0.12); pointer-events: none; }
.hero-arc::before { content: ''; position: absolute; inset: 14%; border-radius: 50%; border: 1px solid rgba(200,180,226,0.07); }
.hero-arc::after { content: ''; position: absolute; inset: 32%; border-radius: 50%; background: radial-gradient(circle, rgba(90,58,140,0.4) 0%, transparent 70%); }
.hero-dot { position: absolute; bottom: 18%; left: 56%; width: 9px; height: 9px; border-radius: 50%; background: var(--sand); opacity: 0.8; }
.hero-eyebrow { font-size: 0.7rem; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--sand); margin-bottom: 1.8rem; opacity: 0; transform: translateY(10px); animation: fadeUp 0.8s 0.3s forwards; }
.hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: end; }
.hero-title { font-family: var(--ff-d); font-size: clamp(3.4rem, 6.5vw, 6.5rem); font-weight: 300; line-height: 1.0; color: #fff; opacity: 0; transform: translateY(20px); animation: fadeUp 1s 0.5s forwards; }
.hero-title em { font-style: italic; color: var(--lavender); display: block; }
.hero-right { display: flex; flex-direction: column; gap: 2.5rem; padding-bottom: 0.4rem; opacity: 0; transform: translateY(14px); animation: fadeUp 0.9s 0.8s forwards; }
.hero-body { font-size: 1.05rem; font-weight: 300; line-height: 1.8; color: rgba(255,255,255,0.48); max-width: 40ch; }
.hero-actions { display: flex; align-items: center; gap: 2rem; }
.btn-primary { display: inline-flex; align-items: center; gap: 0.7rem; font-family: var(--ff-b); font-size: 0.78rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--plum); background: var(--lavender); padding: 0.85rem 1.8rem; text-decoration: none; border-radius: 2px; transition: background 0.3s, transform 0.3s; }
.btn-primary:hover { background: var(--sand); transform: translateX(3px); }
.btn-primary svg { transition: transform 0.3s; }
.btn-primary:hover svg { transform: translateX(3px); }
.btn-ghost { font-size: 0.78rem; font-weight: 400; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.35); text-decoration: none; transition: color 0.3s; display: flex; align-items: center; gap: 0.5rem; }
.btn-ghost:hover { color: var(--lavender); }

/* STRIP */
.strip { background: var(--pale); padding: 0.9rem 0; overflow: hidden; border-bottom: 1px solid rgba(90,58,140,0.1); }
.strip-inner { display: flex; align-items: center; gap: 3rem; animation: marquee 28s linear infinite; white-space: nowrap; width: max-content; }
@keyframes marquee { from{transform:translateX(0)} to{transform:translateX(-50%)} }
.strip-item { font-size: 0.7rem; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase; color: var(--violet); display: flex; align-items: center; gap: 3rem; }
.strip-item::after { content: '✦'; font-size: 0.5rem; color: var(--sand); opacity: 0.7; }

/* SERVICES */
#services { padding: 8rem 4rem; background: var(--off); position: relative; }
.services-header { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; margin-bottom: 5rem; align-items: end; }
.section-label { font-size: 0.67rem; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--violet2); margin-bottom: 1.2rem; }
.section-title { font-family: var(--ff-d); font-size: clamp(2.4rem, 4vw, 4rem); font-weight: 300; line-height: 1.08; color: var(--plum); }
.section-title em { font-style: italic; color: var(--violet2); }
.section-intro { font-size: 1rem; font-weight: 300; line-height: 1.8; color: var(--muted); max-width: 46ch; align-self: end; }
.services-list { display: flex; flex-direction: column; gap: 2px; }

/* SERVICE ROW — ACCORDION */
.service-row { background: var(--off); border: 1px solid rgba(90,58,140,0.08); position: relative; overflow: hidden; transition: background 0.4s, border-color 0.4s; }
.service-row::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--violet); transform: scaleY(0); transform-origin: bottom; transition: transform 0.4s cubic-bezier(0.25,0.46,0.45,0.94); }
.service-row:hover { background: var(--pale); border-color: rgba(90,58,140,0.2); }
.service-row:hover::before, .service-row.open::before { transform: scaleY(1); }
.service-row.open { background: var(--pale); border-color: rgba(90,58,140,0.2); }

.service-row-trigger { display: grid; grid-template-columns: 80px 1fr 2fr auto; align-items: center; gap: 3rem; padding: 2.8rem 3rem; cursor: pointer; user-select: none; }
.service-row-num { font-family: var(--ff-d); font-size: 2.8rem; font-weight: 300; color: rgba(90,58,140,0.18); line-height: 1; transition: color 0.4s; }
.service-row:hover .service-row-num, .service-row.open .service-row-num { color: rgba(90,58,140,0.4); }
.service-row-name { font-family: var(--ff-d); font-size: 1.5rem; font-weight: 400; color: var(--plum); line-height: 1.2; }
.service-row-desc { font-size: 0.92rem; font-weight: 300; line-height: 1.75; color: var(--muted); }
.service-row-right { display: flex; flex-direction: column; align-items: flex-end; gap: 1rem; }
.service-row-tags { display: flex; flex-direction: column; align-items: flex-end; gap: 0.4rem; }
.service-tag { font-size: 0.63rem; font-weight: 400; letter-spacing: 0.1em; text-transform: uppercase; color: var(--violet); background: rgba(90,58,140,0.08); padding: 0.22rem 0.6rem; border-radius: 2px; transition: background 0.3s; }
.service-row:hover .service-tag, .service-row.open .service-tag { background: rgba(90,58,140,0.16); }
.service-chevron { color: var(--violet); opacity: 0.5; transition: transform 0.35s cubic-bezier(0.25,0.46,0.45,0.94), opacity 0.3s; flex-shrink: 0; }
.service-row.open .service-chevron { transform: rotate(180deg); opacity: 1; }

/* ACCORDION PANEL */
.service-expand { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.4s cubic-bezier(0.25,0.46,0.45,0.94); }
.service-row.open .service-expand { grid-template-rows: 1fr; }
.service-expand-inner { overflow: hidden; }
.service-expand-body { margin: 0 3rem 2.4rem; padding-top: 2rem; border-top: 1px solid rgba(90,58,140,0.08); display: grid; grid-template-columns: 1fr 1fr; gap: 2rem 4rem; }
.expand-block-title { font-size: 0.67rem; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--violet2); margin-bottom: 0.6rem; }
.expand-block-body { font-size: 0.88rem; font-weight: 300; line-height: 1.8; color: var(--muted); }

/* AUDIENCE */
#audience { padding: 8rem 4rem; background: var(--plum); position: relative; overflow: hidden; }
#audience::before { content: ''; position: absolute; bottom: -20%; right: -10%; width: 55vw; height: 55vw; border-radius: 50%; border: 1px solid rgba(200,180,226,0.07); pointer-events: none; }
.audience-header { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; margin-bottom: 5rem; align-items: end; }
.audience-header .section-label { color: var(--sand); }
.audience-header .section-title { color: #fff; }
.audience-header .section-intro { color: rgba(255,255,255,0.36); }
.audience-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.5rem; }
.audience-card { padding: 2.5rem; border: 1px solid rgba(200,180,226,0.12); position: relative; overflow: hidden; transition: border-color 0.4s, background 0.4s; cursor: default; }
.audience-card::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 2px; background: linear-gradient(to right, var(--violet), var(--lavender)); transform: scaleX(0); transform-origin: left; transition: transform 0.5s cubic-bezier(0.25,0.46,0.45,0.94); }
.audience-card:hover { border-color: rgba(200,180,226,0.25); background: rgba(255,255,255,0.03); }
.audience-card:hover::after { transform: scaleX(1); }
.audience-icon { width: 36px; height: 36px; color: var(--lavender); margin-bottom: 1.8rem; opacity: 0.7; }
.audience-card-title { font-family: var(--ff-d); font-size: 1.3rem; font-weight: 400; color: #fff; margin-bottom: 0.9rem; }
.audience-card-body { font-size: 0.88rem; font-weight: 300; line-height: 1.75; color: rgba(255,255,255,0.36); }

/* CONTACT */
#contact { padding: 8rem 4rem; background: var(--pale); display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; align-items: start; }
.contact-left .section-title { margin-bottom: 1.2rem; }
.contact-left .section-intro { margin-bottom: 2rem; }
.contact-quote { border-left: 2px solid var(--violet); padding-left: 1.4rem; font-family: var(--ff-d); font-size: 1.05rem; font-style: italic; font-weight: 300; color: var(--violet2); line-height: 1.65; }
.contact-right { display: flex; flex-direction: column; gap: 1.2rem; padding-top: 3.5rem; }
.contact-item { display: flex; align-items: flex-start; gap: 1.2rem; padding: 1.8rem; background: #fff; border: 1px solid rgba(90,58,140,0.08); text-decoration: none; transition: border-color 0.3s, box-shadow 0.3s; }
.contact-item:hover { border-color: rgba(90,58,140,0.25); box-shadow: 0 4px 24px rgba(90,58,140,0.07); }
.contact-item-icon { color: var(--violet); flex-shrink: 0; margin-top: 1px; }
.contact-item-title { font-size: 0.95rem; font-weight: 400; color: var(--plum); margin-bottom: 0.2rem; }
.contact-item-sub { font-size: 0.78rem; font-weight: 300; color: var(--muted); }

/* FOOTER */
footer { background: var(--plum); padding: 2.2rem 4rem; display: flex; align-items: center; justify-content: space-between; }
.footer-logo { font-family: var(--ff-d); font-size: 1rem; font-weight: 300; letter-spacing: 0.06em; color: rgba(255,255,255,0.35); }
.footer-copy { font-size: 0.7rem; letter-spacing: 0.06em; color: rgba(255,255,255,0.2); }

/* ANIMATIONS */
@keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }
.reveal { opacity: 0; transform: translateY(22px); transition: opacity 0.85s cubic-bezier(0.25,0.46,0.45,0.94), transform 0.85s cubic-bezier(0.25,0.46,0.45,0.94); }
.reveal.visible { opacity: 1; transform: translateY(0); }

/* RESPONSIVE */
@media (max-width: 960px) {
  nav { padding: 1.4rem 2rem; }
  .nav-links { display: none; }
  #hero { padding: 0 2rem 4rem; }
  .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  .hero-right { display: none; }
  #services { padding: 5rem 2rem; }
  .services-header { grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: 3rem; }
  .service-row-trigger { grid-template-columns: 50px 1fr auto; gap: 1.2rem; padding: 2rem 1.5rem; }
  .service-row-desc { display: none; }
  .service-row-tags { display: none; }
  .service-expand-body { margin: 0 1.5rem 2rem; grid-template-columns: 1fr; gap: 1.5rem; }
  #audience { padding: 5rem 2rem; }
  .audience-header { grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: 3rem; }
  .audience-grid { grid-template-columns: 1fr; gap: 1rem; }
  #contact { grid-template-columns: 1fr; padding: 5rem 2rem; gap: 3rem; }
  .contact-right { padding-top: 0; }
  footer { padding: 1.8rem 2rem; flex-direction: column; gap: 0.6rem; text-align: center; }
}
</style>
</head>
<body>

<nav id="main-nav">
  <a href="#hero" class="nav-logo">Ousley Utilities</a>
  <ul class="nav-links">
    <li><a href="#services">Services</a></li>
    <li><a href="#audience">Who We Help</a></li>
    <li><a href="#contact">Contact</a></li>
  </ul>
  <a href="#contact" class="nav-cta">Get in Touch</a>
</nav>

<section id="hero">
  <div class="hero-arc"></div>
  <div class="hero-dot"></div>
  <p class="hero-eyebrow">Domestic Energy Connections</p>
  <div class="hero-grid">
    <h1 class="hero-title">
      Your project.<br>
      <em>Connected.</em>
    </h1>
    <div class="hero-right">
      <p class="hero-body">Ousley Utilities manages the full complexity of domestic energy connections — so your development runs on schedule, on budget, and on the grid.</p>
      <div class="hero-actions">
        <a href="#services" class="btn-primary">
          Explore Services
          <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M3 7.5h9M8 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="#contact" class="btn-ghost">
          Talk to us
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none"><path d="M2 6.5h9M7 2.5l4 4-4 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<div class="strip">
  <div class="strip-inner">
    <div class="strip-item">New Connections</div>
    <div class="strip-item">Meter Moves</div>
    <div class="strip-item">Supply Upgrades</div>
    <div class="strip-item">Supply Downgrades</div>
    <div class="strip-item">DNO Liaison</div>
    <div class="strip-item">Domestic Properties</div>
    <div class="strip-item">New Connections</div>
    <div class="strip-item">Meter Moves</div>
    <div class="strip-item">Supply Upgrades</div>
    <div class="strip-item">Supply Downgrades</div>
    <div class="strip-item">DNO Liaison</div>
    <div class="strip-item">Domestic Properties</div>
  </div>
</div>

<section id="services">
  <div class="services-header">
    <div>
      <p class="section-label reveal">What We Do</p>
      <h2 class="section-title reveal" style="transition-delay:0.1s">Specialist services for every stage of your <em>connection</em></h2>
    </div>
    <p class="section-intro reveal" style="transition-delay:0.2s">From first application to energisation, we handle liaison with your Distribution Network Operator, paperwork, and coordination — taking the headache off your hands entirely.</p>
  </div>

  <div class="services-list">

    <!-- 01 New Connections -->
    <div class="service-row reveal">
      <div class="service-row-trigger" role="button" aria-expanded="false" tabindex="0">
        <div class="service-row-num">01</div>
        <div class="service-row-name">New<br>Connections</div>
        <p class="service-row-desc">Bringing a property onto the network from scratch. We manage the full process with your DNO — from feasibility through to live supply — including temporary builder's supplies and pre-booking site checks.</p>
        <div class="service-row-right">
          <div class="service-row-tags">
            <span class="service-tag">New Builds</span>
            <span class="service-tag">DNO Applications</span>
            <span class="service-tag">Temp Supplies</span>
          </div>
          <svg class="service-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M4 6.5l5 5 5-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>
      <div class="service-expand">
        <div class="service-expand-inner">
          <div class="service-expand-body">
            <div>
              <p class="expand-block-title">DNO Application &amp; Feasibility</p>
              <p class="expand-block-body">We manage the full connection application from first contact with the Distribution Network Operator through to confirmed design and accepted offer. We handle the paperwork, chase progress, and keep you informed throughout.</p>
            </div>
            <div>
              <p class="expand-block-title">Temporary Builder's Supplies</p>
              <p class="expand-block-body">Need power on site before the permanent connection is in? We arrange temporary supplies from application through to disconnection once the main supply is established — coordinated alongside your build programme.</p>
            </div>
            <div>
              <p class="expand-block-title">Site Readiness Reviews</p>
              <p class="expand-block-body">Before anything gets booked, we review photos, meter positions, clearances, backboards, and isolator space. Catching issues at this stage saves abortive visits, delays, and costs further down the line.</p>
            </div>
            <div>
              <p class="expand-block-title">Through to Energisation</p>
              <p class="expand-block-body">We stay with the job to the end — coordinating meter installation, supplier registration, and final energisation so your property is live and ready on the day it needs to be.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 02 Meter Moves -->
    <div class="service-row reveal" style="transition-delay:0.05s">
      <div class="service-row-trigger" role="button" aria-expanded="false" tabindex="0">
        <div class="service-row-num">02</div>
        <div class="service-row-name">Meter<br>Moves</div>
        <p class="service-row-desc">Relocating an existing meter for a renovation, extension, or site reconfiguration. We coordinate with the network and manage all associated works, minimising downtime and disruption.</p>
        <div class="service-row-right">
          <div class="service-row-tags">
            <span class="service-tag">Relocations</span>
            <span class="service-tag">Renovations</span>
            <span class="service-tag">Coordination</span>
          </div>
          <svg class="service-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M4 6.5l5 5 5-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>
      <div class="service-expand">
        <div class="service-expand-inner">
          <div class="service-expand-body">
            <div>
              <p class="expand-block-title">What's Involved</p>
              <p class="expand-block-body">A meter move requires sign-off from both your supplier and the network operator. We manage both sides — raising the job, confirming technical requirements, and arranging the works — so nothing falls through the gap between the two.</p>
            </div>
            <div>
              <p class="expand-block-title">Minimising Disruption</p>
              <p class="expand-block-body">We schedule meter moves to align with your build or renovation programme, coordinating disconnection and reconnection windows to keep downtime as short as possible and the project on track.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 03 Supply Upgrades & Downgrades -->
    <div class="service-row reveal" style="transition-delay:0.1s">
      <div class="service-row-trigger" role="button" aria-expanded="false" tabindex="0">
        <div class="service-row-num">03</div>
        <div class="service-row-name">Supply Upgrades<br>&amp; Downgrades</div>
        <p class="service-row-desc">Adjusting supply capacity to match your property's demands. Ideal for high-spec homes with EV infrastructure, heat pumps, or any project needing a right-sized supply from day one.</p>
        <div class="service-row-right">
          <div class="service-row-tags">
            <span class="service-tag">Capacity Changes</span>
            <span class="service-tag">EV-Ready</span>
            <span class="service-tag">Right-Sizing</span>
          </div>
          <svg class="service-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M4 6.5l5 5 5-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>
      <div class="service-expand">
        <div class="service-expand-inner">
          <div class="service-expand-body">
            <div>
              <p class="expand-block-title">Upgrades</p>
              <p class="expand-block-body">Modern homes increasingly demand more from the grid — EV chargers, heat pumps, underfloor heating, and high-load appliances all add up. We manage the upgrade process end-to-end, ensuring your supply matches what the property actually needs.</p>
            </div>
            <div>
              <p class="expand-block-title">Downgrades</p>
              <p class="expand-block-body">Oversized supply capacity carries ongoing standing charges. Where a property's demand is lower than its current supply rating, we can manage a downgrade to bring costs into line — handled cleanly with the network.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 04 Account Management -->
    <div class="service-row reveal" style="transition-delay:0.15s">
      <div class="service-row-trigger" role="button" aria-expanded="false" tabindex="0">
        <div class="service-row-num">04</div>
        <div class="service-row-name">Account<br>Management</div>
        <p class="service-row-desc">Ongoing support once your connection is live. We handle account queries, supplier correspondence, and any issues that arise after energisation — keeping things running smoothly long after the job is done.</p>
        <div class="service-row-right">
